{
  "name": "@jcf-dev/resilience-ts",
  "version": "0.1.0",
  "description": "Composable resilience pipelines for Node: retry, circuit breaker, timeout, rate limiter, fallback and hedging",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "docs/compatibility.md",
    "licenses"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "format:check": "prettier --check .",
    "test:package": "node scripts/verify-package.mjs",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run test:package"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jcf-dev/resilience-ts.git"
  },
  "keywords": [
    "resilience",
    "retry",
    "circuit-breaker",
    "timeout",
    "rate-limiter",
    "fallback",
    "hedging"
  ]
}
